# Copy to server/.env
#
# Local (no Atlas): use in-memory Mongo — data resets when the server stops
MONGODB_URI=memory
#
# Or paste your real Atlas string (Connect → Drivers). Do NOT leave USER/PASS/CLUSTER:
# MONGODB_URI=mongodb+srv://myuser:mypass@cluster0.abc12.mongodb.net/pixelwall?retryWrites=true&w=majority
#
# Or local mongod:
# MONGODB_URI=mongodb://127.0.0.1:27017/pixelwall

PORT=3001
CLIENT_ORIGIN=http://localhost:5173
GRID_SIZE=50
COOLDOWN_MS=10000
